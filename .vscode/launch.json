{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug myapp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/wfoptim",  // 可执行文件路径
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",  // Linux/macOS 用 gdb，macOS 可用 lldb
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}